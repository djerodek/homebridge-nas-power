{
  "name": "homebridge-nas-power",
  "version": "0.1.3",
  "description": "Homebridge plugin to control NAS or Mac power via Wake-on-LAN and SSH shutdown. Works with any Linux-based NAS or macOS machine. Includes SSH host key verification.",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Djerodek",
  "repository": {
    "type": "git",
    "url": "https://github.com/Djerodek/homebridge-nas-power"
  },
  "bugs": {
    "url": "https://github.com/Djerodek/homebridge-nas-power/issues"
  },
  "homepage": "https://github.com/Djerodek/homebridge-nas-power#readme",
  "files": [
    "dist",
    "config.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc --watch",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "nas",
    "wol",
    "wake-on-lan",
    "ssh",
    "macos",
    "nas-power"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "dependencies": {
    "node-ssh": "^13.2.0"
  },
  "devDependencies": {
    "homebridge": "^1.8.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  },
  "peerDependencies": {
    "homebridge": ">=1.6.0"
  }
}
